# ==============================================================================
# OLA SHOES — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit real credentials or .env.local to version control.

# Application Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PostgreSQL Database (Prisma ORM)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ola_shoes?schema=public"

# Authentication & Session Security
# Generate a 32+ character random secret using: openssl rand -base64 32
AUTH_SECRET="your-development-auth-secret-change-in-production-min-32-chars"
ADMIN_INITIAL_EMAIL="admin@olashoes.com"
ADMIN_INITIAL_PASSWORD="ChangeMeInProd123!"

# Paystack Payment Gateway (Nigeria NGN)
# Test keys begin with pk_test_ and sk_test_
# Live keys begin with pk_live_ and sk_live_
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_WEBHOOK_SECRET="your-paystack-webhook-secret"

# Media Storage (Cloudinary / AWS S3)
# Used for product catalog images and variant photography
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Transactional Email (Resend / SendGrid / Postmark)
# Used for order receipts, shipping updates, and password resets
RESEND_API_KEY=""
EMAIL_FROM_ADDRESS="orders@olashoes.com"
EMAIL_SUPPORT_ADDRESS="support@olashoes.com"

# Store Configuration Defaults (Monetary values in integer kobo: 100 kobo = ₦1)
NEXT_PUBLIC_STORE_NAME="Ola Shoes"
NEXT_PUBLIC_CURRENCY_SYMBOL="₦"
NEXT_PUBLIC_STANDARD_SHIPPING_KOBO="250000"
NEXT_PUBLIC_EXPRESS_SHIPPING_KOBO="450000"
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD_KOBO="10000000"
